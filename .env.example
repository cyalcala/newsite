# OpenRouter API Key for Jev 1.13 judgment layer
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Jev Model Identifier (pinned to 1.13)
JEV_MODEL=typesafe/jev-1.13

# Only this OpenRouter base URL is supported (alternate hosts are rejected).
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Optional credential-file override when OPENROUTER_API_KEY is absent.
# Defaults to ~/Desktop/jev777.txt; do not put the key itself here.
# JEV_API_KEY_FILE=C:/Users/admin/Desktop/jev777.txt
